rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /gameUploads/{uid}/{uploadId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 200 * 1024 * 1024;
    }
  }
}
