rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User authentication functions
    function isLoggedIn() {
      return request.auth != null;
    }

    function isAdmin(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isNotBlocked(uid) {
      let user = get(/databases/$(database)/documents/users/$(uid)).data;
      return !user.isBlocked && !user.isBanned;
    }

    // ==================== USERS COLLECTION ====================
    match /users/{userId} {
      // Users can read own profile
      allow read: if isLoggedIn() && (isOwner(userId) || isAdmin(request.auth.uid));
      
      // Users can write to own profile (limited fields)
      allow update: if isLoggedIn() && isOwner(userId) && 
                       request.resource.data.role == resource.data.role && 
                       request.resource.data.uid == resource.data.uid;
      
      // Only admins can write arbitrary user data
      allow write: if isLoggedIn() && isAdmin(request.auth.uid);
      
      // Anyone can create account (signup)
      allow create: if isLoggedIn();
      
      // Admin can delete
      allow delete: if isLoggedIn() && isAdmin(request.auth.uid);
    }

    // Public user profiles (read-only)
    match /users/{userId} {
      allow read: if true;
    }

    // ==================== GAMES COLLECTION ====================
    match /games/{gameId} {
      // Anyone can read games
      allow read: if true;
      
      // Only admins can write games
      allow write: if isLoggedIn() && isAdmin(request.auth.uid);
    }

    // ==================== GAME REVIEWS ====================
    match /game_reviews/{reviewId} {
      // Anyone can read reviews
      allow read: if true;
      
      // Users can create reviews
      allow create: if isLoggedIn() && 
                      request.resource.data.userId == request.auth.uid;
      
      // Users can update own reviews
      allow update: if isLoggedIn() && 
                      resource.data.userId == request.auth.uid;
      
      // Users can delete own reviews
      allow delete: if isLoggedIn() && 
                      resource.data.userId == request.auth.uid;
      
      // Admins can moderate reviews
      allow write: if isLoggedIn() && isAdmin(request.auth.uid);
    }

    // ==================== USER SESSIONS (GAME SAVES) ====================
    match /user_sessions/{sessionId} {
      // Users can read own sessions
      allow read: if isLoggedIn() && 
                     (resource.data.userId == request.auth.uid || 
                      isAdmin(request.auth.uid));
      
      // Users can create sessions
      allow create: if isLoggedIn() && 
                      request.resource.data.userId == request.auth.uid;
      
      // Users can update own sessions
      allow update: if isLoggedIn() && 
                      resource.data.userId == request.auth.uid;
      
      // Admins can access all sessions
      allow write: if isLoggedIn() && isAdmin(request.auth.uid);
    }

    // ==================== FRIEND REQUESTS ====================
    match /friend_requests/{requestId} {
      // Users can read requests sent to them
      allow read: if isLoggedIn() && 
                     (resource.data.toUserId == request.auth.uid || 
                      resource.data.fromUserId == request.auth.uid ||
                      isAdmin(request.auth.uid));
      
      // Users can send requests
      allow create: if isLoggedIn() && 
                      request.resource.data.fromUserId == request.auth.uid &&
                      request.resource.data.fromUserId != request.resource.data.toUserId;
      
      // Users can respond to requests
      allow update: if isLoggedIn() && 
                      resource.data.toUserId == request.auth.uid &&
                      (request.resource.data.status == 'accepted' || 
                       request.resource.data.status == 'rejected');
      
      // Admins can delete
      allow delete: if isLoggedIn() && isAdmin(request.auth.uid);
    }

    // ==================== FRIENDSHIPS ====================
    match /friendships/{friendshipId} {
      // Users can read own friendships
      allow read: if isLoggedIn() && 
                     resource.data.userId == request.auth.uid;
      
      // System creates friendships (no direct writes)
      allow write: if false;
    }

    // ==================== BLOCKED USERS ====================
    match /blocked_users/{blockId} {
      // Users can read own block list
      allow read: if isLoggedIn() && 
                     resource.data.userId == request.auth.uid;
      
      // Users can block others
      allow create: if isLoggedIn() && 
                      request.resource.data.userId == request.auth.uid;
      
      // Admins can manage blocks
      allow write: if isLoggedIn() && isAdmin(request.auth.uid);
    }

    // ==================== POINTS HISTORY ====================
    match /points_history/{transactionId} {
      // Users can read own points history
      allow read: if isLoggedIn() && 
                     resource.data.userId == request.auth.uid;
      
      // System creates transactions
      allow write: if false;
    }

    // ==================== ACHIEVEMENTS ====================
    match /achievements/{achievementId} {
      // Users can read own achievements
      allow read: if isLoggedIn() && 
                     resource.data.userId == request.auth.uid;
      
      // System grants achievements
      allow write: if false;
    }

    // ==================== GAME STATS ====================
    match /game_stats/{statId} {
      // Users can read own stats
      allow read: if isLoggedIn() && 
                     resource.data.userId == request.auth.uid;
      
      // System updates stats
      allow write: if false;
    }

    // ==================== USER DOWNLOADS ====================
    match /user_downloads/{downloadId} {
      // Users can read own downloads
      allow read: if isLoggedIn() && 
                     resource.data.userId == request.auth.uid;
      
      // System records downloads
      allow write: if false;
    }

    // ==================== ADMIN LOGS ====================
    match /admin_logs/{logId} {
      // Only admins can read logs
      allow read: if isLoggedIn() && isAdmin(request.auth.uid);
      
      // System creates logs
      allow write: if false;
    }

    // ==================== LEADERBOARD (View Only) ====================
    match /leaderboard/{leaderboardId} {
      // Public read for leaderboards
      allow read: if true;
      
      // System only
      allow write: if false;
    }

    // ==================== CATCH-ALL ====================
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
